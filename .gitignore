# ==========================================
# PYTHON ENVIRONMENTS
# ==========================================
.venv/
venv/
ENV/
env/

# ==========================================
# PYTHON CACHE FILES
# ==========================================
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ==========================================
# ENVIRONMENT VARIABLES AND SECRETS
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# TRAINED MODELS
# ==========================================
# Ignore all model files by default
*.keras
*.h5
*.hdf5
*.weights.h5

# Allow only the model required by Flask inference
!artifacts/
artifacts/*
!artifacts/parkinson_effnetv2s_classweighted.keras
!artifacts/temperature.json

# ==========================================
# DATASETS
# ==========================================
# Include raw and processed dataset files
# Large image files are managed through Git LFS

# ==========================================
# GENERATED REPORTS
# ==========================================
reports/**/*.png
reports/**/*.csv
reports/**/*.json

# ==========================================
# UPLOADS AND GENERATED GRAD-CAM OUTPUTS
# ==========================================
uploads/*
!uploads/.gitkeep

static/gradcam/*
!static/gradcam/.gitkeep

# ==========================================
# LOCAL BACKUPS
# ==========================================
*.bak
*.local_backup

# ==========================================
# OPERATING SYSTEM FILES
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
data/raw/spiral/
data/raw/wave/
